<!--
  ============================================================
  LP - Format De Meerpaal — gebaseerd op template Heldense Bossen
  ============================================================
  Onderzoek verwerkt:
  - Vakantiepark De Meerpaal ligt bij Zoutelande, Zeeland
  - Positionering: op loopafstand van strand, aan de voet van de duinen
  - Thema: zee, duinen, kleurrijk groen, wellness en kinderspeelplezier
  - Officiële pluspunten: strand, 72 jaar, 9,1 Ardoer-score, brasserie,
    VOC-speelschip, waterspeeltuin, airtrampoline, wellness
  ============================================================
-->
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kamperen aan zee bij Zoutelande — Vakantiepark De Meerpaal</title>
<link href="https://fonts.googleapis.com/css2?family=Enriqueta:wght@400;600;700&family=Signika:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --groen: #0099c8;
    --blauw: #005e96;
    --oranje: #e76f00;       /* Ardoer accent */
    --tekst: #333333;
    --lichtgroen: #e7f6fb;
    --lichtblauw: #e7f6fb;
    --wit: #ffffff;
    --grijs: #f3f8f4;
    --donkerblauw: #01284a;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Signika', sans-serif; font-size: 16px; color: var(--tekst); background: var(--wit); }
  h1,h2,h3,h4 { font-family: 'Enriqueta', serif; }
  h1 { font-size: 42px; font-weight: 700; line-height: 1.15; }
  h2 { font-size: 32px; font-weight: 600; line-height: 1.2; }
  h3 { font-size: 22px; font-weight: 600; }
  p { line-height: 1.75; }
  img { max-width: 100%; display: block; }
  a { color: var(--blauw); text-decoration: none; }

  .btn { display: inline-block; padding: 13px 30px; border-radius: 4px; font-family: 'Signika', sans-serif; font-size: 15px; font-weight: 600; cursor: pointer; transition: opacity 0.2s, transform 0.15s; border: none; }
  .btn:hover { opacity: 0.88; transform: translateY(-1px); }
  .btn-blauw { background: var(--blauw); color: #fff; }
  .btn-oranje { background: var(--oranje); color: #fff; }
  .btn-groen { background: var(--groen); color: #fff; }
  .btn-outline { background: transparent; color: var(--blauw); border: 2px solid var(--blauw); }

  /* HEADER */
  .header { position: relative; height: 540px; overflow: hidden; }
  .header-img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .header-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.52) 100%); }
  .header-content { position: absolute; bottom: 0; left: 0; right: 0; padding: 48px 60px; color: #fff; }
  .header-content h1 { color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,0.3); max-width: 700px; }
  .header-badge { display: inline-block; background: var(--oranje); color: #fff; font-size: 13px; font-weight: 600; padding: 5px 14px; border-radius: 20px; margin-bottom: 16px; letter-spacing: 0.04em; }

  /* BREADCRUMB */
  .breadcrumb-bar { background: var(--lichtgroen); border-bottom: 1px solid #c5dbef; padding: 10px 60px; }
  .breadcrumb { font-size: 13px; color: #666; }
  .breadcrumb a { color: var(--groen); }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: var(--tekst); font-weight: 500; }

  /* SAMENVATTING */
  .samenvatting { background: var(--lichtgroen); border-left: 5px solid var(--groen); padding: 28px 36px; margin: 40px 60px; border-radius: 0 8px 8px 0; }
  .samenvatting p { font-size: 17px; color: #1d3a52; line-height: 1.8; }

  /* CONTAINER */
  .container { max-width: 1100px; margin: 0 auto; padding: 0 60px; }
  .section { padding: 64px 0; }
  .section-title { color: var(--groen); margin-bottom: 8px; }
  .section-sub { font-size: 17px; color: #666; margin-bottom: 36px; }
  .divider { height: 3px; width: 60px; background: var(--oranje); margin: 12px 0 28px; border-radius: 2px; }

  /* INTRO */
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .intro-text h2 { margin-bottom: 8px; }
  .intro-text p { margin: 16px 0 24px; font-size: 16px; }
  .intro-img { border-radius: 12px; overflow: hidden; height: 380px; }
  .intro-img img { width: 100%; height: 100%; object-fit: cover; }

  /* USPs */
  .usp-section { background: var(--groen); padding: 64px 60px; }
  .usp-title { color: #fff; text-align: center; margin-bottom: 8px; }
  .usp-sub { text-align: center; color: rgba(255,255,255,0.85); margin-bottom: 48px; font-size: 16px; }
  .usp-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; max-width: 1100px; margin: 0 auto; }
  .usp-item { text-align: center; }
  .usp-icon { width: 72px; height: 72px; margin: 0 auto 14px; }
  .usp-icon svg { width: 72px; height: 72px; }
  .usp-label { color: #fff; font-size: 14px; font-weight: 500; line-height: 1.4; }

  /* DOELGROEP BLOK */
  .doelgroep-section { background: #eef2f5; padding: 72px 60px; text-align: center; }
  .doelgroep-title { font-size: 36px; color: var(--blauw); max-width: 640px; margin: 0 auto 12px; line-height: 1.2; }
  .doelgroep-sub { font-size: 16px; color: #666; max-width: 520px; margin: 0 auto 48px; }
  .doelgroep-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1100px; margin: 0 auto; }
  .doelgroep-card { background: #fff; border-radius: 16px; padding: 32px 28px; text-align: left; border: 1px solid #d8e0e8; }
  .doelgroep-card h3 { color: var(--blauw); font-size: 18px; margin-bottom: 12px; }
  .doelgroep-card p { font-size: 15px; color: #555; line-height: 1.65; }

  /* FACILITEITEN */
  .fac-section { background: var(--grijs); padding: 64px 0; }
  .fac-bullets-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; margin-top: 4px; }
  .fac-list { list-style: none; }
  .fac-list li { display: flex; align-items: flex-start; gap: 12px; padding: 11px 0; border-bottom: 1px solid #d6e4ef; font-size: 15px; }
  .fac-list li::before { content: "✓"; color: var(--groen); font-weight: 700; font-size: 16px; margin-top: 1px; flex-shrink: 0; }

  /* GALLERY */
  .gallery-section { padding: 64px 0; }
  .gallery-wrapper { position: relative; }
  .gallery-scroll { display: flex; gap: 16px; overflow-x: hidden; padding: 0 60px 8px; scroll-behavior: smooth; }
  .gallery-thumb { flex-shrink: 0; width: 320px; height: 220px; border-radius: 10px; overflow: hidden; }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .gallery-thumb:hover img { transform: scale(1.04); }
  .gallery-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; background: var(--wit); border: 2px solid var(--groen); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 10; transition: background 0.2s, color 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.12); }
  .gallery-arrow:hover { background: var(--groen); }
  .gallery-arrow:hover svg { stroke: #fff; }
  .gallery-arrow svg { stroke: var(--groen); width: 20px; height: 20px; }
  .gallery-arrow.prev { left: 12px; }
  .gallery-arrow.next { right: 12px; }

  /* AANBOD */
  .aanbod-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 36px; }
  .aanbod-card { background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #d8e0e8; transition: box-shadow 0.2s, transform 0.2s; }
  .aanbod-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.12); transform: translateY(-3px); }
  .aanbod-img { height: 200px; overflow: hidden; }
  .aanbod-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .aanbod-card:hover .aanbod-img img { transform: scale(1.05); }
  .aanbod-body { padding: 20px; }
  .aanbod-body h3 { font-size: 18px; margin-bottom: 10px; color: var(--blauw); }
  .aanbod-bullets { list-style: none; margin-bottom: 16px; }
  .aanbod-bullets li { font-size: 13px; color: #555; padding: 4px 0 4px 16px; position: relative; line-height: 1.5; }
  .aanbod-bullets li::before { content: "•"; color: var(--groen); font-weight: 700; position: absolute; left: 0; }
  .aanbod-center { text-align: center; }

  /* REVIEWS — Ardoer stijl */
  .reviews-section { padding: 64px 0; }
  .reviews-ardoer { background: var(--groen); border-radius: 16px; padding: 36px 40px; display: grid; grid-template-columns: auto 1fr auto; gap: 40px; align-items: center; }
  .reviews-score { display: flex; align-items: center; gap: 16px; background: rgba(255,255,255,0.15); border-radius: 12px; padding: 20px 28px; }
  .score-heart { color: #fff; font-size: 28px; }
  .score-num-big { font-family: 'Enriqueta', serif; font-size: 44px; font-weight: 700; color: #fff; line-height: 1; }
  .score-basis-txt { font-size: 13px; color: rgba(255,255,255,0.85); margin-top: 4px; }
  .reviews-bars { display: flex; flex-direction: column; gap: 10px; }
  .bar-item { display: flex; align-items: center; gap: 12px; }
  .bar-label-txt { font-size: 13px; color: rgba(255,255,255,0.9); width: 170px; flex-shrink: 0; }
  .bar-track { flex: 1; height: 10px; background: rgba(255,255,255,0.25); border-radius: 5px; overflow: hidden; }
  .bar-fill-oranje { height: 10px; background: var(--oranje); border-radius: 5px; }
  .bar-score { font-size: 14px; font-weight: 600; color: #fff; min-width: 28px; text-align: right; }
  .reviews-quote { background: rgba(255,255,255,0.12); border-radius: 12px; padding: 20px 24px; max-width: 260px; }
  .reviews-quote p { font-size: 14px; color: #fff; line-height: 1.65; font-style: italic; }
  .btn-meer { display: inline-block; margin-top: 16px; background: var(--oranje); color: #fff; font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: 4px; }

  /* QUOTES onder reviews */
  .quotes-below { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 24px; }
  .quote-card { background: #fff; border-radius: 10px; padding: 18px 20px; border: 1px solid #d0dce8; }
  .quote-name { font-weight: 600; font-size: 14px; color: var(--blauw); margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; }
  .stars { color: var(--oranje); font-size: 13px; }
  .quote-text { font-size: 14px; color: #555; line-height: 1.6; font-style: italic; }

  /* OMGEVING */
  .omgeving-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .omgeving-img { border-radius: 12px; overflow: hidden; height: 340px; }
  .omgeving-img img { width: 100%; height: 100%; object-fit: cover; }
  .attrac-list { list-style: none; margin-top: 8px; }
  .attrac-item { display: flex; align-items: baseline; gap: 14px; padding: 12px 0; border-bottom: 1px solid #eee; }
  .attrac-min { font-size: 12px; font-weight: 700; color: var(--oranje); min-width: 40px; background: #fff3e8; padding: 3px 8px; border-radius: 20px; text-align: center; }
  .attrac-name { font-weight: 600; font-size: 14px; color: var(--blauw); min-width: 160px; }
  .attrac-desc { font-size: 13px; color: #888; }

  /* FAQ */
  .faq-section { background: var(--grijs); padding: 64px 0; }
  .faq-list { max-width: 760px; margin: 0 auto; }
  .faq-item { border-bottom: 1px solid #ddd; }
  .faq-q { width: 100%; text-align: left; padding: 18px 0; font-family: 'Signika'; font-size: 16px; font-weight: 600; color: var(--tekst); background: none; border: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq-q:hover { color: var(--groen); }
  .faq-icon { font-size: 20px; color: var(--groen); flex-shrink: 0; transition: transform 0.2s; font-style: normal; }
  .faq-a { font-size: 15px; color: #555; padding: 0 0 18px; line-height: 1.75; display: none; }
  .faq-item.open .faq-a { display: block; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  /* GERELATEERD */
  .gerelateerd-section { padding: 48px 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .chip { background: var(--lichtgroen); border: 1px solid #b0d0e8; color: var(--groen); padding: 8px 18px; border-radius: 24px; font-size: 14px; font-weight: 500; transition: background 0.2s; cursor: pointer; }
  .chip:hover { background: var(--groen); color: #fff; }

  /* FOOTER */
  .footer-wave { width: 100%; overflow: hidden; line-height: 0; }
  .footer-wave svg { display: block; width: 100%; }
  .footer-main { background: var(--donkerblauw); color: #fff; padding: 48px 60px; }
  .footer-grid { display: grid; grid-template-columns: 180px 1fr 1fr 1fr; gap: 40px; max-width: 1100px; margin: 0 auto; }
  .footer-social { display: flex; gap: 10px; margin-bottom: 0; }
  .footer-social a { width: 42px; height: 42px; background: var(--oranje); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .footer-social svg { width: 18px; height: 18px; fill: #fff; }
  .footer-col h4 { font-family: 'Signika', sans-serif; font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 16px; }
  .footer-col p, .footer-col a { font-size: 14px; color: rgba(255,255,255,0.75); line-height: 2; display: block; }
  .footer-col a:hover { color: #fff; }
  .footer-col .contact-item { display: flex; gap: 8px; align-items: flex-start; margin-bottom: 4px; font-size: 14px; color: rgba(255,255,255,0.75); }
  .footer-col .contact-item strong { color: #fff; }
  .footer-bottom { background: var(--donkerblauw); border-top: 1px solid rgba(255,255,255,0.1); padding: 20px 60px; }
  .footer-bottom-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
  .footer-logos { display: flex; gap: 16px; align-items: center; }
  .ardoer-logo { font-family: 'Enriqueta', serif; font-size: 20px; font-weight: 700; color: #fff; }
  .ardoer-logo span { color: var(--oranje); }
  .top-badge { background: var(--blauw); color: #fff; font-size: 11px; font-weight: 700; padding: 6px 12px; border-radius: 6px; border: 2px solid var(--oranje); text-align: center; }
  .footer-copy { font-size: 12px; color: rgba(255,255,255,0.5); }

  @media(max-width: 900px) {
    .container { padding: 0 24px; }
    .intro-grid, .omgeving-grid { grid-template-columns: 1fr; }
    .usp-grid { grid-template-columns: repeat(3, 1fr); }
    .aanbod-grid { grid-template-columns: 1fr 1fr; }
    .doelgroep-grid { grid-template-columns: 1fr; }
    .quotes-below { grid-template-columns: 1fr; }
    .reviews-ardoer { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
    h1 { font-size: 30px; }
    .header { height: 380px; }
    .header-content { padding: 28px 24px; }
    .breadcrumb-bar { padding: 10px 24px; }
    .samenvatting { margin: 24px; padding: 20px 24px; }
    .usp-section { padding: 48px 24px; }
    .doelgroep-section { padding: 48px 24px; }
  }
  @media(max-width: 600px) {
    .usp-grid { grid-template-columns: repeat(2, 1fr); }
    .aanbod-grid { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<!-- HEADER -->
<header class="header">
  <img class="header-img" src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80" alt="Strand en duinen bij Zoutelande">
  <div class="header-overlay"></div>
  <div class="header-content">
    <div class="header-badge">★ 9,1 Ardoer-score · Strand op loopafstand</div>
    <h1>Vakantie vieren aan zee bij<br>Zoutelande</h1>
  </div>
</header>

<!-- BREADCRUMB onder hero -->
<div class="breadcrumb-bar">
  <nav class="breadcrumb"><a href="#">Home</a> › <a href="#">Campings</a> › <a href="#">Zeeland</a> › <span>De Meerpaal</span></nav>
</div>

<!-- SAMENVATTING -->
<div class="samenvatting">
  <p>Op zoek naar een vakantiepark vlak bij strand, duinen en het gezellige Zoutelande? Vakantiepark De Meerpaal ligt aan de voet van de duinen in Zeeland en combineert kamperen, chalets, safaritenten, wellness en volop speelplezier voor kinderen.</p>
</div>

<!-- INTRO -->
<section class="section">
  <div class="container">
    <div class="intro-grid">
      <div class="intro-text">
        <h2 class="section-title">Welkom bij De Meerpaal</h2>
        <div class="divider"></div>
        <p>Welkom bij Vakantiepark De Meerpaal, een Zeeuwse plek waar stranddagen, duinwandelingen en ontspannen parkcomfort vanzelf samenkomen. Je verblijft vlak bij Zoutelande, omringd door groen, bloemen en de frisse sfeer van de kust.</p>
        <p>Met luxe comfortplaatsen, chalets, safaritenten, een brasserie, wellness en avontuurlijke speelplekken is De Meerpaal gemaakt voor gezinnen die dicht bij zee willen genieten.</p>
        <a href="#" class="btn btn-blauw" style="margin-top:8px;">Boek je vakantie →</a>
      </div>
      <div class="intro-img">
        <img src="https://images.unsplash.com/photo-1470214203634-e436a8848e23?auto=format&fit=crop&w=900&q=80" alt="Duinen en strand aan de Zeeuwse kust">
      </div>
    </div>
  </div>
</section>

<!-- USPs -->
<section class="usp-section">
  <h2 class="usp-title">Waarom De Meerpaal?</h2>
  <p class="usp-sub">Vijf redenen waarom gasten hier keer op keer terugkomen</p>
  <div class="usp-grid">
    <div class="usp-item">
      <!-- Icoon: water / golven -->
      <div class="usp-icon"><svg viewBox="0 0 72 72" fill="none"><circle cx="36" cy="36" r="34" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/><path d="M14 38 Q22 32 30 38 Q38 44 46 38 Q54 32 58 38" stroke="#7dd3e8" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M14 46 Q22 40 30 46 Q38 52 46 46 Q54 40 58 46" stroke="#a8e0f0" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M14 30 Q22 24 30 30 Q38 36 46 30 Q54 24 58 30" stroke="#c8eaf5" stroke-width="2" fill="none" stroke-linecap="round"/></svg></div>
      <div class="usp-label">Op loopafstand van strand en duinen</div>
    </div>
    <div class="usp-item">
      <!-- Icoon: zeilboot -->
      <div class="usp-icon"><svg viewBox="0 0 72 72" fill="none"><circle cx="36" cy="36" r="34" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/><path d="M14 50 L58 50 L52 56 L20 56 Z" fill="#e0c070"/><rect x="35" y="14" width="2" height="36" fill="#e8e8e0"/><path d="M37 16 L52 46 L37 46 Z" fill="#fff"/><path d="M14 50 Q26 46 38 50 Q50 54 58 50" stroke="#7dd3e8" stroke-width="2" fill="none" stroke-linecap="round"/></svg></div>
      <div class="usp-label">Brasserie De Meerpaal op het park</div>
    </div>
    <div class="usp-item">
      <!-- Icoon: zwembad -->
      <div class="usp-icon"><svg viewBox="0 0 72 72" fill="none"><circle cx="36" cy="36" r="34" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/><rect x="14" y="38" width="44" height="18" rx="4" fill="#7dd3e8"/><path d="M14 44 Q22 40 30 44 Q38 48 46 44 Q54 40 58 44" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="24" cy="30" r="5" fill="#f5c060" stroke="#e8a030" stroke-width="1"/><path d="M24 35 L22 44 M24 35 L26 44" stroke="#888" stroke-width="1.5" stroke-linecap="round"/></svg></div>
      <div class="usp-label">VOC-speelschip en waterspeeltuin</div>
    </div>
    <div class="usp-item">
      <!-- Icoon: strand / zon -->
      <div class="usp-icon"><svg viewBox="0 0 72 72" fill="none"><circle cx="36" cy="36" r="34" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/><circle cx="36" cy="28" r="9" fill="#f5c060" stroke="#e8a030" stroke-width="1.5"/><path d="M20 28 L23 28 M52 28 L49 28 M36 12 L36 15 M28 22 L26 20 M44 22 L46 20" stroke="#f5e080" stroke-width="2" stroke-linecap="round"/><path d="M14 50 Q26 46 36 48 Q46 50 58 48 L58 56 L14 56 Z" fill="#e8d090"/></svg></div>
      <div class="usp-label">Wellness, salon en massage</div>
    </div>
    <div class="usp-item">
      <!-- Icoon: hart met cijfer -->
      <div class="usp-icon"><svg viewBox="0 0 72 72" fill="none"><circle cx="36" cy="36" r="34" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/><path d="M36 52 C36 52 16 40 16 28 C16 22 21 18 27 18 C30.5 18 33.5 19.5 36 22 C38.5 19.5 41.5 18 45 18 C51 18 56 22 56 28 C56 40 36 52 36 52Z" fill="#e85a7a"/><text x="36" y="34" text-anchor="middle" font-size="12" font-family="Enriqueta,serif" font-weight="700" fill="#fff">9,1</text></svg></div>
      <div class="usp-label">Beoordeeld met een 9,1 door Ardoer-gasten</div>
    </div>
  </div>
</section>

<!-- DOELGROEP BLOK -->
<section class="doelgroep-section">
  <h2 class="doelgroep-title">Een Zeeuwse vakantie waarin iedereen landt</h2>
  <p class="doelgroep-sub">Een kustvakantie vraagt om strand dichtbij, genoeg te doen voor kinderen en rust voor de volwassenen.</p>
